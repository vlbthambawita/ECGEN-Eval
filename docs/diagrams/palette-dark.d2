# Dark palette — imported as `_palette.d2` by render.sh
vars: {
  d2-config: {
    theme-id: 200
    pad: 24
  }
}
style.fill: transparent

classes: {
  io: {
    shape: page
    style: {fill: "#1e293b"; stroke: "#94a3b8"; font-color: "#e2e8f0"; border-radius: 6}
  }
  data: {
    style: {fill: "#082f49"; stroke: "#38bdf8"; font-color: "#e0f2fe"; border-radius: 10; shadow: true}
  }
  metric: {
    style: {fill: "#4c0519"; stroke: "#fb7185"; font-color: "#ffe4e6"; border-radius: 10; shadow: true}
  }
  feature: {
    style: {fill: "#052e16"; stroke: "#4ade80"; font-color: "#dcfce7"; border-radius: 10; shadow: true}
  }
  viz: {
    style: {fill: "#2e1065"; stroke: "#a78bfa"; font-color: "#ede9fe"; border-radius: 10; shadow: true}
  }
  report: {
    style: {fill: "#451a03"; stroke: "#fbbf24"; font-color: "#fef3c7"; border-radius: 10; shadow: true}
  }
  model: {
    style: {fill: "#1e293b"; stroke: "#94a3b8"; font-color: "#f1f5f9"; border-radius: 10; shadow: true}
  }
  group: {
    style: {fill: "#0f172a"; stroke: "#475569"; font-color: "#cbd5e1"; border-radius: 14; stroke-dash: 3}
  }
  flow: {
    style: {stroke: "#94a3b8"; stroke-width: 2; font-color: "#cbd5e1"}
  }
  hot: {
    style: {stroke: "#fb7185"; stroke-width: 3; font-color: "#fda4af"; animated: true}
  }
  soft: {
    style: {stroke: "#64748b"; stroke-width: 2; stroke-dash: 4; font-color: "#94a3b8"}
  }
}
