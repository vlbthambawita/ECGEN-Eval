# Clinical feature extraction (user-guide/features.md)
...@_palette
direction: down

rec: "Recording\n(L, T)" {class: data; style.multiple: true}

backend: "Delineation backend  ·  backend=" {
  class: group
  hybrid: "hybrid (default)\nR peaks: nk.ecg_peaks on primary lead\nQRS: spatial velocity of all leads\nP, T: nk prominence per lead (median)\nT end: tangent method" {class: feature}
  others: "neurokit2\nnk.ecg_delineate: dwt · cwt · peak · prominence\n\nscipy\nPan–Tompkins + spatial-velocity QRS, no P/T\n\ncustom\nDelineationBackend + register_backend" {class: model}
}

ctx: "RecordingContext\nrpeaks · waves (fiducials per beat)\nrecording · lead_names · fs" {class: data}

groups: "Feature groups  ·  features=" {
  class: group
  rhythm: "rhythm\nRR · HR" {class: feature}
  intervals: "intervals\nPR · QRS · QT · QTc · P-wave\nper beat → median" {class: feature}
  hrv: "hrv\nSDNN · RMSSD · pNN50" {class: feature}
  amp: "amplitude\nST deviation · T amplitude\nper lead vs PR baseline" {class: feature}
  custom: "custom\nfunc(ctx) → dict · @feature_group\nFeatureGroup subclass" {class: model}
}

summary: "summary_df\n1 row / recording\nselected columns" {class: report; shape: stored_data}
beats: "beat_df\n1 row / (recording, beat, lead)" {class: report; shape: stored_data}

rec -> backend: {class: hot}
backend -> ctx: "(rpeaks, waves)" {class: hot}
ctx -> groups: {class: flow}
groups -> summary: compute() {class: flow}
groups -> beats: "per_beat() · per_lead()" {class: flow}
