# Clinical feature extraction (user-guide/features.md)
...@_palette
direction: down

rec: "Recording\n(L, T)" {class: data; style.multiple: true}

primary: "Primary lead\n(lead_for_intervals, default II)" {
  class: group
  peaks: "R-peak detection\nnk.ecg_clean() + nk.ecg_peaks()\n↳ SciPy Pan–Tompkins fallback" {class: feature}
  rr: "RR · HR" {class: feature}
  hrv: "SDNN · RMSSD · pNN50" {class: feature}
  peaks -> rr: {class: flow}
  peaks -> hrv: {class: flow}
}

all: "All leads" {
  class: group
  delin: "Beat delineation\nQRS: spatial velocity of all leads\nP, T: nk prominence per lead (median)\nT end: tangent method" {class: feature}
  intervals: "PR · QRS · QT · QTc · P-wave\nper beat → median" {class: feature}
  amp: "ST deviation · T-wave amplitude\nper lead vs PR baseline" {class: feature}
  delin -> intervals: {class: flow}
  delin -> amp: beat fiducials {class: flow}
}

summary: "summary_df\n1 row / recording" {class: report; shape: stored_data}
beats: "beat_df\n1 row / (recording, beat, lead)" {class: report; shape: stored_data}

rec -> primary.peaks: {class: hot}
rec -> all.delin: {class: hot}
primary.peaks -> all.delin: R-peaks {class: soft}
primary.rr -> summary: {class: flow}
primary.hrv -> summary: {class: flow}
all.intervals -> summary: {class: flow}
all.intervals -> beats: {class: flow}
all.amp -> summary: lead average {class: flow}
all.amp -> beats: {class: flow}
