# Light palette — imported as `_palette.d2` by render.sh
vars: {
  d2-config: {
    theme-id: 0
    pad: 24
  }
}
style.fill: transparent

classes: {
  io: {
    shape: page
    style: {fill: "#f8fafc"; stroke: "#64748b"; font-color: "#1e293b"; border-radius: 6}
  }
  data: {
    style: {fill: "#e0f2fe"; stroke: "#0284c7"; font-color: "#0c4a6e"; border-radius: 10; shadow: true}
  }
  metric: {
    style: {fill: "#ffe4e6"; stroke: "#e11d48"; font-color: "#881337"; border-radius: 10; shadow: true}
  }
  feature: {
    style: {fill: "#dcfce7"; stroke: "#16a34a"; font-color: "#14532d"; border-radius: 10; shadow: true}
  }
  viz: {
    style: {fill: "#ede9fe"; stroke: "#7c3aed"; font-color: "#3b0764"; border-radius: 10; shadow: true}
  }
  report: {
    style: {fill: "#fef3c7"; stroke: "#d97706"; font-color: "#78350f"; border-radius: 10; shadow: true}
  }
  model: {
    style: {fill: "#f1f5f9"; stroke: "#475569"; font-color: "#0f172a"; border-radius: 10; shadow: true}
  }
  group: {
    style: {fill: "#ffffff"; stroke: "#cbd5e1"; font-color: "#334155"; border-radius: 14; stroke-dash: 3}
  }
  flow: {
    style: {stroke: "#64748b"; stroke-width: 2; font-color: "#475569"}
  }
  hot: {
    style: {stroke: "#e11d48"; stroke-width: 3; font-color: "#be123c"; animated: true}
  }
  soft: {
    style: {stroke: "#94a3b8"; stroke-width: 2; stroke-dash: 4; font-color: "#64748b"}
  }
}
